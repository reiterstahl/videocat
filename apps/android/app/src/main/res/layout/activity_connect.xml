<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/connect_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Centers the card vertically when it fits and lets it scroll when the keyboard is up. -->
    <LinearLayout
        tools:ignore="UselessParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/connect_gutter"
        android:paddingVertical="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_title"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/connect_intro"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/connect_label"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/connect_address"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="url"
                android:background="@drawable/field"
                android:hint="@string/connect_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="yes"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/connect_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/connect_warning_plain"
                android:textColor="@color/warning"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/connect_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/connect_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_accent"
                android:stateListAnimator="@null"
                android:text="@string/connect_button"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:text="@string/connect_note"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
