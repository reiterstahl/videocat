{
  "name": "@videocat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@prisma/client": "6.12.0",
    "@videocat/shared": "0.1.0",
    "aws4fetch": "1.0.20",
    "fastify": "^5.12.3",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.12.0",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "@types/ws": "^8.18.2",
    "jpeg-js": "^0.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
