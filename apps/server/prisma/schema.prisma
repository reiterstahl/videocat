generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Disk {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  // Set when the name was chosen in the web: scans keep it instead of the detected one.
  nameLocked           Boolean               @default(false)
  // "drive" (scanned by a Companion) or "s3" (a StorageBucket the server scans).
  kind                 String                @default("drive")
  volumeLabel          String?
  volumeId             String?
  driveLetter          String?
  totalBytes           BigInt?
  freeBytes            BigInt?
  fileSystem           String?
  firstScannedAt       DateTime              @default(now())
  lastScannedAt        DateTime              @default(now())
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  scans                Scan[]
  files                VideoFile[]
  agentErrors          AgentError[]
  deletionRecords      DeletionRecord[]
  transferDestinations TransferDestination[]
  folderFavorites      FolderFavorite[]
  storageBucket        StorageBucket?

  @@index([name])
  @@index([volumeId])
}

model Scan {
  id             String       @id @default(uuid()) @db.Uuid
  diskId         String       @db.Uuid
  rootPath       String
  status         String       @default("running")
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  fileCount      Int          @default(0)
  errorCount     Int          @default(0)
  leaseOwner     String?
  generation     Int          @default(0)
  leaseExpiresAt DateTime?
  disk           Disk         @relation(fields: [diskId], references: [id], onDelete: Cascade)
  agentErrors    AgentError[]

  @@index([diskId])
  @@index([status])
  @@index([diskId, rootPath, status, leaseExpiresAt])
  @@index([diskId, rootPath, generation])
}

model VideoFile {
  id                 String                @id @default(uuid()) @db.Uuid
  diskId             String                @db.Uuid
  filename           String
  extension          String
  absolutePath       String
  relativePath       String
  sizeBytes          BigInt
  folderSizeBytes    BigInt?
  fileCreatedAt      DateTime?
  modifiedAt         DateTime?
  scanStatus         String                @default("pending")
  errorMessage       String?
  durationSeconds    Float?
  width              Int?
  height             Int?
  fps                Float?
  videoCodec         String?
  audioCodec         String?
  audioChannels      Int?
  bitrate            BigInt?
  containerFormat    String?
  streamCount        Int?
  ffprobeJson        Json?
  visualFingerprint  String?
  fingerprintVersion Int?
  // S3 objects only: tells a changed object apart and follows one copied to another key.
  storageEtag        String?
  // Asked from the web: read again a file at risk (bad sectors); cleared when a scan reads it.
  readRetryAt        DateTime?
  fingerprintedAt    DateTime?
  curationStatus     String                @default("none")
  reviewedAt         DateTime?
  isPresent          Boolean               @default(true)
  missingSince       DateTime?
  lastSeenScanId     String?               @db.Uuid
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  disk               Disk                  @relation(fields: [diskId], references: [id], onDelete: Cascade)
  thumbnails         Thumbnail[]
  categories         VideoFileCategory[]
  downloadQueue      DownloadQueue?
  streamSessions     StreamSession[]
  transferItems      TransferItem[]
  groupIgnores       TransferGroupIgnore[]

  @@unique([diskId, relativePath])
  @@index([diskId])
  @@index([sizeBytes])
  @@index([folderSizeBytes])
  @@index([extension])
  @@index([durationSeconds])
  @@index([width])
  @@index([height])
  @@index([videoCodec])
  @@index([fingerprintVersion])
  @@index([modifiedAt])
  @@index([curationStatus])
  @@index([reviewedAt])
  @@index([isPresent])
  @@index([diskId, isPresent])
  @@index([diskId, isPresent, curationStatus])
  @@index([isPresent, curationStatus, reviewedAt])
}

model DownloadQueue {
  id                String    @id @default(uuid()) @db.Uuid
  videoFileId       String    @unique @db.Uuid
  status            String    @default("queued")
  source            String    @default("manual")
  requestedAt       DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  destinationPath   String?
  downloadedTag     String?
  errorMessage      String?
  progressBytes     BigInt    @default(0)
  progressUpdatedAt DateTime?
  updatedAt         DateTime  @updatedAt
  videoFile         VideoFile @relation(fields: [videoFileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requestedAt])
  @@index([completedAt])
  @@index([source])
}

model DeletionRecord {
  id           String    @id @default(uuid()) @db.Uuid
  videoFileId  String    @unique @db.Uuid
  diskId       String?   @db.Uuid
  diskName     String
  filename     String
  relativePath String
  sizeBytes    BigInt
  status       String
  source       String    @default("review")
  requestedAt  DateTime?
  attemptedAt  DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?
  companionId  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  disk         Disk?     @relation(fields: [diskId], references: [id], onDelete: SetNull)

  @@index([diskId])
  @@index([status])
  @@index([attemptedAt])
  @@index([completedAt])
}

model AgentError {
  id           String   @id @default(uuid()) @db.Uuid
  diskId       String   @db.Uuid
  scanId       String?  @db.Uuid
  category     String
  phase        String
  code         String?
  message      String
  absolutePath String?
  relativePath String?
  createdAt    DateTime @default(now())
  disk         Disk     @relation(fields: [diskId], references: [id], onDelete: Cascade)
  scan         Scan?    @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([diskId])
  @@index([scanId])
  @@index([category])
  @@index([phase])
  @@index([createdAt])
}

model ActionAudit {
  id             String    @id @default(uuid()) @db.Uuid
  action         String
  status         String    @default("started")
  actorType      String
  actorId        String?
  requestId      String?
  idempotencyKey String?   @unique
  diskId         String?   @db.Uuid
  videoFileId    String?   @db.Uuid
  target         String?
  metadata       Json?
  result         Json?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([action, createdAt])
  @@index([status, createdAt])
  @@index([diskId, createdAt])
  @@index([videoFileId, createdAt])
  @@index([actorType, actorId, createdAt])
}

model CurationCategory {
  key       String              @id
  label     String
  color     String
  builtIn   Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  files     VideoFileCategory[]
  tagRules  TransferTagRule[]

  @@index([builtIn])
  @@index([label])
}

model VideoFileCategory {
  videoFileId String           @db.Uuid
  categoryKey String
  createdAt   DateTime         @default(now())
  videoFile   VideoFile        @relation(fields: [videoFileId], references: [id], onDelete: Cascade)
  category    CurationCategory @relation(fields: [categoryKey], references: [key], onDelete: Cascade)

  @@id([videoFileId, categoryKey])
  @@index([categoryKey])
  @@index([videoFileId])
}

model AppMetric {
  key         String   @id
  valueBigInt BigInt   @default(0)
  updatedAt   DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanionAgent {
  installationId     String    @id @db.Uuid
  name               String?
  version            Int       @default(0)
  mountedDiskCount   Int       @default(0)
  mountedDiskIds     Json?
  capabilities       Json?
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  revokedAt          DateTime?
  credentialHash     String?   @unique
  credentialIssuedAt DateTime?
  authMode           String    @default("legacy")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([lastSeenAt])
  @@index([revokedAt])
}

model CompanionPairingCode {
  id          String    @id @default(uuid()) @db.Uuid
  codeHash    String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  claimedAt   DateTime?
  claimedById String?   @db.Uuid

  @@index([expiresAt])
  @@index([claimedAt])
}

model StreamSession {
  id              String    @id @default(uuid()) @db.Uuid
  videoFileId     String    @db.Uuid
  // Who serves the bytes: a Companion through its tunnel, or the server from an S3 bucket.
  companionId     String?   @db.Uuid
  storageBucketId String?   @db.Uuid
  ownerUsername   String
  status          String    @default("opening")
  mode            String    @default("original")
  fileSizeBytes   BigInt?
  mimeType        String?
  expiresAt       DateTime
  lastAccessedAt  DateTime?
  completedAt     DateTime?
  errorCode       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  videoFile       VideoFile @relation(fields: [videoFileId], references: [id], onDelete: Cascade)

  @@index([videoFileId])
  @@index([companionId, status])
  @@index([expiresAt])
}

model Thumbnail {
  id               String    @id @default(uuid()) @db.Uuid
  videoFileId      String    @db.Uuid
  kind             String
  timestampSeconds Float?
  relativePath     String
  createdAt        DateTime  @default(now())
  videoFile        VideoFile @relation(fields: [videoFileId], references: [id], onDelete: Cascade)

  @@unique([videoFileId, kind])
  @@index([videoFileId])
}

// Folders marked with a star: the only places that may receive transferred files.
model TransferDestination {
  id            String                @id @default(uuid()) @db.Uuid
  diskId        String                @db.Uuid
  path          String
  nameKey       String
  // Optional extra words that "Agrupar archivos" also looks for, besides the folder name.
  groupKeywords String[]              @default([])
  createdAt     DateTime              @default(now())
  disk          Disk                  @relation(fields: [diskId], references: [id], onDelete: Cascade)
  jobs          TransferJob[]
  tagRules      TransferTagRule[]
  ignored       TransferGroupIgnore[]

  @@unique([diskId, path])
  @@index([nameKey])
}

// Favourite folders: their videos (and their subfolders') are never offered to move elsewhere.
model FolderFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  diskId    String   @db.Uuid
  path      String
  createdAt DateTime @default(now())
  disk      Disk     @relation(fields: [diskId], references: [id], onDelete: Cascade)

  @@unique([diskId, path])
}

// Files the person chose to leave alone (J) when grouping into a folder; not proposed again.
model TransferGroupIgnore {
  destinationId String              @db.Uuid
  videoFileId   String              @db.Uuid
  createdAt     DateTime            @default(now())
  destination   TransferDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  videoFile     VideoFile           @relation(fields: [videoFileId], references: [id], onDelete: Cascade)

  @@id([destinationId, videoFileId])
  @@index([videoFileId])
}

// "Mover por etiqueta": every video with this tag goes to the starred folder, now and later.
model TransferTagRule {
  id            String              @id @default(uuid()) @db.Uuid
  categoryKey   String              @unique
  destinationId String              @db.Uuid
  createdAt     DateTime            @default(now())
  category      CurationCategory    @relation(fields: [categoryKey], references: [key], onDelete: Cascade)
  destination   TransferDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  jobs          TransferJob[]
}

model TransferJob {
  id            String              @id @default(uuid()) @db.Uuid
  kind          String
  destinationId String              @db.Uuid
  status        String              @default("active")
  label         String
  // Set for transfers created by a "Mover por etiqueta" rule.
  tagRuleId     String?             @db.Uuid
  tagRule       TransferTagRule?    @relation(fields: [tagRuleId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  destination   TransferDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  items         TransferItem[]

  @@index([status])
}

// One file on its way from a source drive, through the Companion's local staging folder,
// to the destination folder. The state machine lives in src/lib/transfer-states.ts.
model TransferItem {
  id                 String      @id @default(uuid()) @db.Uuid
  jobId              String      @db.Uuid
  videoFileId        String?     @db.Uuid
  filename           String
  sourceDiskId       String      @db.Uuid
  sourceRelativePath String
  targetDiskId       String      @db.Uuid
  targetFolder       String
  targetRelativePath String?
  sizeBytes          BigInt
  expectedModifiedAt DateTime?
  sha256             String?
  state              String      @default("pending")
  claimedBy          String?     @db.Uuid
  attempts           Int         @default(0)
  error              String?
  stagedAt           DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  job                TransferJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Kept after the catalog entry is removed (identical file already at the destination).
  videoFile          VideoFile?  @relation(fields: [videoFileId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([state])
  @@index([sourceDiskId, state])
  @@index([targetDiskId, state])
  @@index([videoFileId])
}

// An S3-compatible bucket (or a prefix inside it) that the server catalogues like a drive. The
// secret key is sealed with STORAGE_SECRET_KEY (src/lib/secret-box.ts) and never leaves the server.
model StorageBucket {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  endpoint         String
  region           String
  bucket           String
  prefix           String    @default("")
  forcePathStyle   Boolean   @default(true)
  accessKeyId      String
  secretSealed     String
  secretHint       String    @default("")
  // The catalog drive this bucket fills; set by its first scan.
  diskId           String?   @unique @db.Uuid
  disk             Disk?     @relation(fields: [diskId], references: [id], onDelete: SetNull)
  lastCheckedAt    DateTime?
  lastCheckOk      Boolean?
  lastCheckFailure Json?
  // Scans by the videocat-scanner container (src/scanner.ts).
  scanRequestedAt  DateTime?
  scanStatus       String    @default("idle")
  scanStartedAt    DateTime?
  scanFinishedAt   DateTime?
  scanHeartbeatAt  DateTime?
  scanProgress     Json?
  scanFailure      Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
